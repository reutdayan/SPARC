{
    "dataset": "wikics",
    "n_clusters": 10,
    "is_sparse_graph": false,
    "should_check_generalization": true,
    "spectral": {
        "architecture": {
            "n_layers": 6,
            "hidden_dim1": 1024,
            "hidden_dim2": 1024,
            "hidden_dim3": 512,
            "output_dim": 20
        },
        "epochs": 1000,
        "lr": 0.0005,
        "lr_decay": 0.5,
        "min_lr": 1e-05,
        "batch_size": 10000,
        "n_neighbors": 8,
        "scale_k": 5,
        "is_local_scale": true,
        "n_clusters": 7,
        "patience": 20,
        "bsize": 1,
        "num_clusters": 1,
        "num_clusters_val": 20,
        "num_clusters_test": 1,
        "diag_lambda": -1,
        "affinity_walk_order": 2,
        "cache_partitions": true,
        "partition_cache_dir": null
    },
    "diagnostics": {
        "eigenspace_agreement": true,
        "k": null,
        "laplacian_type": "sym_multihop",
        "drop_first": false,
        "restrict_to_lcc": true,
        "eig_method": "auto",
        "eig_tol": 1e-06,
        "max_nodes": 150000
    },
    "augmentation": {
        "feature_knn": {
            "enabled": true,
            "k": 20,
            "metric": "cosine",
            "mutual": false
        }
    }
}
