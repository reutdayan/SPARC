{
    "dataset": "ogbn-products",
    "n_clusters": 47,
    "is_sparse_graph": false,
    "should_check_generalization": true,
    "spectral": {
        "architecture": {
            "n_layers": 6,
            "hidden_dim1": 1024,
            "hidden_dim2": 1024,
            "hidden_dim3": 512,
            "output_dim": 47
        },
        "epochs": 1000,
        "lr": 0.001,
        "lr_decay": 0.5,
        "min_lr": 1e-05,
        "lr_threshold": 0.01,
        "lr_threshold_mode": "rel",
        "lr_cooldown": 5,
        "batch_size": 10000,
        "n_neighbors": 30,
        "scale_k": 15,
        "is_local_scale": true,
        "n_clusters": 7,
        "patience": 20,
        "bsize": 20,
        "num_clusters": 2000,
        "num_clusters_val": 200,
        "num_clusters_test": 200,
        "diag_lambda": 0.01,
        "cache_partitions": true,
        "partition_cache_dir": null,
        "affinity_walk_order": 2,
        "constrained_loss": {
            "enabled": true,
            "mu_mode": "auto",
            "target_ratio": 0.2,
            "mu_min": 0.0,
            "mu_max": 10000.0,
            "mu_ema_decay": 0.9,
            "mu": 1.0,
            "min_train_nodes": 16
        }
    },
    "diagnostics": {
        "eigenspace_agreement": true,
        "k": null,
        "laplacian_type": "sym_multihop",
        "drop_first": false,
        "restrict_to_lcc": true,
        "eig_method": "auto",
        "eig_tol": 1e-06,
        "max_nodes": 150000
    },
    "augmentation": {
        "feature_knn": {
            "_comment": "Disabled: 2.4M nodes makes sklearn brute-force kNN infeasible. Re-enable only with an approximate-kNN backend (e.g. faiss).",
            "enabled": false,
            "k": 10,
            "metric": "cosine",
            "mutual": true
        }
    }
}
